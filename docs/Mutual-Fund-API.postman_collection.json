						"body": {
							"mode": "raw",
							"raw": "{\n    \"fundId\": {{fundId}},\n    \"units\": 5.25\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}/redeem",
