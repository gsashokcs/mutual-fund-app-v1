								"v1",
								"users",
								"{{userId}}",
								"holdings"
							]
						},
						"description": "Retrieve all mutual fund holdings for a user with current values"
					},
					"response": []
				},
				{
					"name": "View Transactions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}/transactions?page=0&size=10&sortBy=transactionDate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"{{userId}}",
								"transactions"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "sortBy",
									"value": "transactionDate"
								}
							]
						},
						"description": "Retrieve transaction history for a user with pagination"
					},
					"response": []
				}
			],
			"description": "User transaction and holdings management endpoints"
		},
		{
